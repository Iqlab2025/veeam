{
  "__inputs": [
    {
      "name": "DS_SQLITE",
      "label": "SQLite (backup_dash.db)",
      "type": "datasource",
      "pluginId": "frser-sqlite-datasource",
      "pluginName": "SQLite"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "frser-sqlite-datasource",
      "name": "SQLite",
      "version": "3.0.0"
    }
  ],
  "title": "Backup Overview",
  "uid": "backup-overview",
  "tags": [
    "backup",
    "veeam"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "15m",
  "schemaVersion": 39,
  "version": 7,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Backups (selected range)",
      "type": "stat",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT count(*) AS total, coalesce(sum(status='SUCCESS'),0) AS success,\n       coalesce(sum(status='WARNING'),0) AS warning, coalesce(sum(status='FAILED'),0) AS failed\nFROM runs WHERE kind='BACKUP' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')",
          "rawQueryText": "SELECT count(*) AS total, coalesce(sum(status='SUCCESS'),0) AS success,\n       coalesce(sum(status='WARNING'),0) AS warning, coalesce(sum(status='FAILED'),0) AS failed\nFROM runs WHERE kind='BACKUP' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "links": [
            {
              "title": "Open backup runs",
              "targetBlank": true,
              "url": "/d/backup-runs/backup-runs?var-status=${__field.name}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Failed backups by vendor / workload",
      "type": "barchart",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 14,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT vendor || ' / ' || workload AS failure, vendor, workload, count(*) AS failed\nFROM runs WHERE kind='BACKUP' AND status='FAILED' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')\nGROUP BY vendor, workload ORDER BY failed DESC",
          "rawQueryText": "SELECT vendor || ' / ' || workload AS failure, vendor, workload, count(*) AS failed\nFROM runs WHERE kind='BACKUP' AND status='FAILED' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')\nGROUP BY vendor, workload ORDER BY failed DESC",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "links": [
            {
              "title": "Open these failed runs",
              "targetBlank": true,
              "url": "/d/backup-runs/backup-runs?var-status=failed&var-vendor=${__data.fields.vendor}&var-workload=${__data.fields.workload}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "failure",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "title": "Backup job trend (per day)",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT CAST(strftime('%s', date(start_time)) AS INTEGER) AS time,\n       sum(status='SUCCESS') AS success, sum(status='WARNING') AS warning, sum(status='FAILED') AS failed\nFROM runs WHERE kind='BACKUP' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')\nGROUP BY date(start_time) ORDER BY time",
          "rawQueryText": "SELECT CAST(strftime('%s', date(start_time)) AS INTEGER) AS time,\n       sum(status='SUCCESS') AS success, sum(status='WARNING') AS warning, sum(status='FAILED') AS failed\nFROM runs WHERE kind='BACKUP' AND start_time BETWEEN datetime(${__from:date:seconds},'unixepoch') AND datetime(${__to:date:seconds},'unixepoch')\nGROUP BY date(start_time) ORDER BY time",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Storage utilization (click for trend)",
      "type": "stat",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT sum(used) AS used_gb, sum(total) AS capacity_gb, round(100.0 * sum(used) / sum(total), 1) AS used_pct\nFROM capacity WHERE kind='STORAGE'\n  AND (vendor, collected_at) IN (SELECT vendor, max(collected_at) FROM capacity WHERE kind='STORAGE' GROUP BY vendor)",
          "rawQueryText": "SELECT sum(used) AS used_gb, sum(total) AS capacity_gb, round(100.0 * sum(used) / sum(total), 1) AS used_pct\nFROM capacity WHERE kind='STORAGE'\n  AND (vendor, collected_at) IN (SELECT vendor, max(collected_at) FROM capacity WHERE kind='STORAGE' GROUP BY vendor)",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "links": [
            {
              "title": "Open trend",
              "targetBlank": true,
              "url": "/d/backup-capacity/backup-capacity?${__url_time_range}"
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "transformations": []
    },
    {
      "id": 5,
      "title": "License utilization (click for trend)",
      "type": "stat",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT sum(used) AS used, sum(total) AS licensed, round(100.0 * sum(used) / sum(total), 1) AS used_pct\nFROM capacity WHERE kind='LICENSE'\n  AND (vendor, collected_at) IN (SELECT vendor, max(collected_at) FROM capacity WHERE kind='LICENSE' GROUP BY vendor)",
          "rawQueryText": "SELECT sum(used) AS used, sum(total) AS licensed, round(100.0 * sum(used) / sum(total), 1) AS used_pct\nFROM capacity WHERE kind='LICENSE'\n  AND (vendor, collected_at) IN (SELECT vendor, max(collected_at) FROM capacity WHERE kind='LICENSE' GROUP BY vendor)",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "links": [
            {
              "title": "Open trend",
              "targetBlank": true,
              "url": "/d/backup-capacity/backup-capacity?${__url_time_range}"
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "transformations": []
    },
    {
      "id": 6,
      "title": "RPO compliance: target ${rpo_target_hours}h vs actual",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT vendor, name, workload, last_backup,\n       ${rpo_target_hours} * 3600 AS rpo_target,\n       CAST((julianday('now') - julianday(last_backup)) * 86400 AS INTEGER) AS data_loss_window,\n       CASE WHEN last_backup IS NULL OR (julianday('now') - julianday(last_backup)) * 24 > ${rpo_target_hours}\n            THEN 'BREACHED' ELSE 'MET' END AS rpo_status,\n       last_run_failed\nFROM protected_objects ORDER BY rpo_status = 'MET', data_loss_window DESC",
          "rawQueryText": "SELECT vendor, name, workload, last_backup,\n       ${rpo_target_hours} * 3600 AS rpo_target,\n       CAST((julianday('now') - julianday(last_backup)) * 86400 AS INTEGER) AS data_loss_window,\n       CASE WHEN last_backup IS NULL OR (julianday('now') - julianday(last_backup)) * 24 > ${rpo_target_hours}\n            THEN 'BREACHED' ELSE 'MET' END AS rpo_status,\n       last_run_failed\nFROM protected_objects ORDER BY rpo_status = 'MET', data_loss_window DESC",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rpo_target"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "data_loss_window"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rpo_status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "MET": {
                        "color": "green",
                        "index": 0
                      },
                      "BREACHED": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "RTO - measured restore time (min)",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 14,
        "y": 19,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryType": "table",
          "queryText": "SELECT * FROM v_rto",
          "rawQueryText": "SELECT * FROM v_rto",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "rpo_target_hours",
        "label": "RPO target (hours)",
        "type": "custom",
        "query": "24,1,4,12,48",
        "hide": 0,
        "current": {
          "text": "24",
          "value": "24"
        },
        "options": [
          {
            "text": "24",
            "value": "24",
            "selected": true
          },
          {
            "text": "1",
            "value": "1",
            "selected": false
          },
          {
            "text": "4",
            "value": "4",
            "selected": false
          },
          {
            "text": "12",
            "value": "12",
            "selected": false
          },
          {
            "text": "48",
            "value": "48",
            "selected": false
          }
        ]
      }
    ]
  }
}